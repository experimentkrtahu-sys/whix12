generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ShowStatus {
  ONGOING
  COMPLETED
  UPCOMING
}

enum ShowType {
  MOVIE
  SERIES
  OVA
  SPECIAL
  DOCUMENTARY
  COURSE
}

enum WatchLanguage {
  SUB
  DUB
  RAW
  ORIGINAL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(USER)
  isActive      Boolean        @default(true)
  profile       Profile?
  bookmarks     Bookmark[]
  watchHistory  WatchHistory[]
  ratings       Rating[]
  createdShows  Show[]         @relation("ShowCreatedBy")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  avatarUrl   String?
  bio         String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Show {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  altTitles        String[]
  synopsis         String
  posterUrl        String
  bannerUrl        String?
  releaseYear      Int
  status           ShowStatus
  type             ShowType
  totalEpisodes    Int                 @default(0)
  cast             String[]
  featured         Boolean             @default(false)
  trending         Boolean             @default(false)
  latestRelease    Boolean             @default(false)
  recentlyAdded    Boolean             @default(false)
  published        Boolean             @default(true)
  viewCount        Int                 @default(0)
  createdById      String?
  createdBy        User?               @relation("ShowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  episodes         Episode[]
  showGenres       ShowGenre[]
  showTags         ShowTag[]
  showStudios      ShowStudio[]
  showProducers    ShowProducer[]
  ratings          Rating[]
  recommendations  Recommendation[]    @relation("RecommendationFrom")
  recommendedBy    Recommendation[]    @relation("RecommendationTo")
  homepageFeatures HomepageFeature[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([title])
  @@index([releaseYear])
}

model Episode {
  id            String                @id @default(cuid())
  showId         String
  slug           String
  number         Int
  title          String
  synopsis       String?
  thumbnailUrl   String?
  releaseDate    DateTime?
  durationMin    Int?
  externalSources ExternalVideoSource[]
  watchHistory   WatchHistory[]
  show           Show                  @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([showId, number])
  @@unique([showId, slug])
  @@index([showId, releaseDate])
}

model Genre {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  shows     ShowGenre[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  shows     ShowTag[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Studio {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  shows     ShowStudio[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Producer {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  shows     ShowProducer[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ExternalVideoSource {
  id               String        @id @default(cuid())
  episodeId        String
  label            String
  embedUrl         String
  externalWatchUrl String?
  language         WatchLanguage @default(ORIGINAL)
  qualityLabel     String?
  isPrimary        Boolean       @default(false)
  isActive         Boolean       @default(true)
  episode          Episode       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([episodeId, isActive])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  showId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, showId])
}

model WatchHistory {
  id            String   @id @default(cuid())
  userId         String
  episodeId      String
  progressSec    Int      @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode        Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, lastWatchedAt])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  showId    String
  value     Int
  review    String?
  isPublic  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  show      Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, showId])
  @@index([showId, value])
}

model Recommendation {
  id             String   @id @default(cuid())
  fromShowId     String
  toShowId       String
  score          Float    @default(0.5)
  fromShow       Show     @relation("RecommendationFrom", fields: [fromShowId], references: [id], onDelete: Cascade)
  toShow         Show     @relation("RecommendationTo", fields: [toShowId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([fromShowId, toShowId])
}

model HomepageFeature {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  showId      String?
  show        Show?    @relation(fields: [showId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShowGenre {
  showId    String
  genreId   String
  show      Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  genre     Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([showId, genreId])
}

model ShowTag {
  showId    String
  tagId     String
  show      Show   @relation(fields: [showId], references: [id], onDelete: Cascade)
  tag       Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([showId, tagId])
}

model ShowStudio {
  showId    String
  studioId  String
  show      Show    @relation(fields: [showId], references: [id], onDelete: Cascade)
  studio    Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([showId, studioId])
}

model ShowProducer {
  showId     String
  producerId String
  show       Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  producer   Producer  @relation(fields: [producerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@id([showId, producerId])
}
